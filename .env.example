# ------------------------------------------------------------------
# SafeRoute frontend configuration (copy to .env.local)
# Only PUBLIC values belong here. They are bundled into the browser.
# Never put service-role keys, Resend keys or OpenRouteService keys here.
# ------------------------------------------------------------------

# Supabase project (Project Settings -> API). The anon key is designed to be public;
# Row Level Security protects the data. Leave both empty to run in Demo Mode.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Optional: set to true once the notify function and Resend are set up, to show
# "Email invitation" next to the share link in SafeCircle.
VITE_EMAIL_ENABLED=

# Optional: support address shown on the Contact and Help pages.
VITE_SUPPORT_EMAIL=

# Optional: override the basemap style (MapLibre style JSON URL).
# Default: OpenFreeMap "positron" (free, no key).
VITE_MAP_STYLE_URL=

# Optional: override the Overpass API endpoint used for OpenStreetMap street details.
VITE_OVERPASS_URL=
